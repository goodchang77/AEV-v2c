# Database
DATABASE_URL=postgresql://user:password@localhost:5432/financial_db
REDIS_URL=redis://localhost:6379

# AI Agent Configuration
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# MCP Server Configuration
MCP_MAX_CONCURRENT_TOOLS=5
MCP_CACHE_ENABLED=true
MCP_CACHE_TTL_SECONDS=3600

# Application（本機開發範本；所有值都是佔位字串，請勿用於生產）
# ENVIRONMENT 決定設定類別：development / testing / production
ENVIRONMENT=development
DEBUG=true
APP_VERSION=2.0.0

# JWT 簽章金鑰：產生方式 openssl rand -hex 32
# production 模式下若缺漏、少於 32 字元或為預設/佔位值，應用程式會拒絕啟動。
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# production 必填（逗號分隔）；development 可留空使用預設值
# ALLOWED_HOSTS=api.example.com
# ALLOWED_ORIGINS=https://app.example.com
