# Azure VM 生產環境變數範本
# ============================
# 複製為 .env.production 並填入真實值：
#   cp .env.production.example .env.production
# ⚠️ .env.production 含機敏資料，切勿 commit（已在 .gitignore 內）。

# 映像檔版本標籤
VERSION=latest

# PostgreSQL（compose 內建資料庫）
POSTGRES_DB=financial_analysis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# 應用層密鑰與 API Key
# SECRET_KEY 用於 JWT 簽章，請用 `openssl rand -hex 32` 產生
SECRET_KEY=change-me-64-char-random-string
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
ANTHROPIC_API_KEY=your-anthropic-key
