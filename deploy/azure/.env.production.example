# Azure VM 生產環境變數範本（docker-compose.azure.yml 使用）
# ======================================================
# 複製為 .env.production 並填入真實值：
#   cp deploy/azure/.env.production.example deploy/azure/.env.production
#   chmod 600 deploy/azure/.env.production
# ⚠️ .env.production 含機敏資料，切勿 commit（.gitignore 已排除 .env.*，僅保留 *.example）。
# ⚠️ 以下 CHANGE_ME_* 皆為「佔位字串」，不是可用的密碼；未替換前請勿上線。
#    標示為「必填」者若留空，docker compose 會直接報錯；應用程式在 production 模式下
#    也會拒絕以缺漏 / 過短（<32 字元）/ 已知預設值的 SECRET_KEY 啟動。

# 映像檔版本標籤
VERSION=latest

# ---- 執行環境（compose 已固定為 production；此處僅供說明/一致性）----
ENVIRONMENT=production
DEBUG=false

# ---- 對外存取（必填，逗號分隔，不要有空白）----
# ALLOWED_HOSTS：TLS 反向代理轉發進來的 Host 名稱（容器健康檢查用的 localhost/127.0.0.1 會自動允許）
ALLOWED_HOSTS=CHANGE_ME_api.example.com
# ALLOWED_ORIGINS：允許 CORS 的前端來源（含 https://）
ALLOWED_ORIGINS=https://CHANGE_ME_app.example.com

# ---- PostgreSQL（compose 內建資料庫，不對外發布 port）----
POSTGRES_DB=financial_analysis
POSTGRES_USER=postgres
# 必填。產生：openssl rand -hex 32（用 hex 避免 URL 特殊字元問題）
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# ---- Redis（不對外發布 port，啟用 requirepass）----
# 必填。產生：openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# ---- 應用層密鑰 ----
# 必填。JWT 簽章用；產生：openssl rand -hex 32（至少 32 字元）
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ---- 外部 API Key（選填）----
ALPHA_VANTAGE_API_KEY=
ANTHROPIC_API_KEY=
