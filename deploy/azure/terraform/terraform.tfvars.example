# 複製為 terraform.tfvars 並填入你的值
#   cp terraform.tfvars.example terraform.tfvars
# ⚠️ terraform.tfvars 可能含機敏資訊，切勿 commit（.gitignore 已防護）

project_name      = "aev"
location          = "japaneast"        # 對台延遲最低；備選 eastasia / southeastasia
vm_size           = "Standard_B2ms"    # 2 vCPU / 8GB RAM
admin_username    = "azureuser"
ssh_public_key_path = "~/.ssh/id_rsa.pub"

# 建議改成你自己的對外 IP（例如 "123.45.67.89/32"），不要全開 SSH
ssh_source_cidr   = "0.0.0.0/0"
